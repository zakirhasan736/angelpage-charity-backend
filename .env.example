# Server
PORT=5000
NODE_ENV=development
# Required — min 16 chars; do not use placeholders like change-me in production
JWT_SECRET=
# Access token lifetime (default 30m). Use 1h+ in dev to reduce refresh churn.
ACCESS_TOKEN_EXPIRY=1h
# Refresh token lifetime (default 7d)
REFRESH_TOKEN_EXPIRY=30d
FRONTEND_BASE_URL=https://staging.angelpage.co.uk

# MongoDB (runtime reads MONGO_URI)
MONGO_URI=mongodb://localhost:27017/angelpage

# SendGrid — verify sender domain angelpage.co.uk in SendGrid dashboard
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@angelpage.co.uk

# Stripe
# Payments master switch. Leave false for the affiliate-only launch:
# no checkout, donations, labels, Stripe onboarding or payouts.
PAYMENTS_ENABLED=false
# Stripe Connect country for charity accounts (USA-only launch)
STRIPE_CONNECT_COUNTRY=US
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADMIN_ACCOUNT_ID=

# Shopify inbound webhooks (HMAC)
SHOPIFY_WEBHOOK_SECRET=

# ShipStation
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# OAuth (optional — login/register via Google & Facebook on frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Path to the Google service account JSON used for Sheets. Never commit that file.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Social auto-posting (runs when admin approves a listing)
# Meta: Facebook Page feed + Instagram Business (Page must be linked to IG Professional account)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v19.0
# TikTok Content Posting API — seller must enable TikTok + provide listing video
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Optional in dev if TURNSTILE_SECRET_KEY unset (verification skipped)
TURNSTILE_SECRET_KEY=

# Marketing journeys (optional)
MARKETING_PROVIDER=brevo
BREVO_API_KEY=

# Background jobs (optional — BullMQ scheduled posts & affiliate sync)
REDIS_URL=

# Google Gemini AI (listing assist, image search, blog/event SEO)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Realtime message and notification hooks (header: x-angelpage-hook-secret)
NOTIFICATION_WEBHOOK_SECRET=

# eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_ENV=PRODUCTION
# Required to accept inbound eBay notifications (reject unsigned when unset)
EBAY_WEBHOOK_VERIFICATION_TOKEN=

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_WRITE_MAX=40

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Charity product integration (encrypts stored API keys; defaults to JWT_SECRET)
INTEGRATION_ENCRYPTION_KEY=

# --- Creator social accounts: import reels + auto-post (each platform optional) ---
# Reels:    import from TikTok, Instagram, YouTube, Facebook; auto-post to the same four
# Products: auto-post to Facebook, Instagram, TikTok, LinkedIn, X
# Public base of this API including /api. OAuth redirect URIs are
#   {API_PUBLIC_URL}/social-connect/{tiktok|instagram|youtube}/callback
API_PUBLIC_URL=https://api.angelpage.com/api
# TikTok for Developers: Login Kit + Content Posting API (user.info.basic, video.list, video.publish).
# Public posting needs TikTok's app audit; before that, posts are private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta: "Instagram API with Instagram Login" (instagram_business_basic, instagram_business_content_publish)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Google Cloud OAuth client, YouTube Data API v3 (youtube.readonly, youtube.upload). Falls back to GOOGLE_CLIENT_ID/SECRET.
# Unverified Google apps upload as private until the app passes Google's audit.
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public
# Meta app with Facebook Login for Business (pages_show_list, pages_read_engagement, pages_manage_posts)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: Instagram link previews (oEmbed) for pasted links
FACEBOOK_CLIENT_TOKEN=
# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" (w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202501
# X developer app, OAuth 2.0 confidential client (tweet.read tweet.write users.read offline.access)
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok pulls product photos from a verified domain: verify your API domain in TikTok's portal and set
SOCIAL_MEDIA_PROXY_URL=https://api.angelpage.com/api/social-connect/media

# Server
PORT=5000
NODE_ENV=development
# Required — min 16 chars; do not use placeholders like change-me in production
JWT_SECRET=
# Access token lifetime (default 30m). Use 1h+ in dev to reduce refresh churn.
ACCESS_TOKEN_EXPIRY=1h
# Refresh token lifetime (default 7d)
REFRESH_TOKEN_EXPIRY=30d
FRONTEND_BASE_URL=https://staging.angelpage.co.uk

# MongoDB (runtime reads MONGO_URI)
MONGO_URI=mongodb://localhost:27017/angelpage

# SendGrid — verify sender domain angelpage.co.uk in SendGrid dashboard
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@angelpage.co.uk

# Stripe
# Payments master switch (default true). Set false only to pause checkout,
# donations, labels, Stripe onboarding and payouts in one go.
PAYMENTS_ENABLED=true
# Stripe Connect country for charity accounts (USA-only launch)
STRIPE_CONNECT_COUNTRY=US
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADMIN_ACCOUNT_ID=

# Shopify inbound webhooks (HMAC)
SHOPIFY_WEBHOOK_SECRET=

# ShipStation
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# OAuth (optional — login/register via Google & Facebook on frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Path to the Google service account JSON used for Sheets. Never commit that file.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Social auto-posting (runs when admin approves a listing)
# Meta: Facebook Page feed + Instagram Business (Page must be linked to IG Professional account)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v19.0
# TikTok Content Posting API — seller must enable TikTok + provide listing video
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Optional in dev if TURNSTILE_SECRET_KEY unset (verification skipped)
TURNSTILE_SECRET_KEY=

# Marketing journeys (optional)
MARKETING_PROVIDER=brevo
BREVO_API_KEY=

# Background jobs (optional — BullMQ scheduled posts & affiliate sync)
REDIS_URL=

# Google Gemini AI (listing assist, image search, blog/event SEO)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Realtime message and notification hooks (header: x-angelpage-hook-secret)
NOTIFICATION_WEBHOOK_SECRET=

# eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_ENV=PRODUCTION
# Required to accept inbound eBay notifications (reject unsigned when unset)
EBAY_WEBHOOK_VERIFICATION_TOKEN=

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_WRITE_MAX=40

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Charity product integration (encrypts stored API keys; defaults to JWT_SECRET)
INTEGRATION_ENCRYPTION_KEY=

# eBay Partner Network marketplace for the curated affiliate feed (USA launch)
EBAY_MARKETPLACE_ID=EBAY_US

# Native push for the iOS app (APNs token auth). Leave empty to disable.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Paste the .p8 contents; use \n for line breaks on one line
APNS_PRIVATE_KEY=

# Shared secret the website sends to POST /api/auth/oauth (x-angelpage-oauth-secret).
# Required in production; set the same value as OAUTH_BRIDGE_SECRET on the frontend server.
OAUTH_BRIDGE_SECRET=

# iOS app sign-in (POST /api/auth/mobile/social): allowed audiences
APPLE_AUDIENCES=
GOOGLE_AUDIENCES=
# iOS app: keys that skip Turnstile on login/register/reset (X-Angelpage-App-Key)
MOBILE_APP_KEYS=
